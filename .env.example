# Copy this file to .env and fill in your own values. Never commit .env.

# Flask (APP_ENV: development, testing or production - see config.py)
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
LOG_LEVEL=INFO

# MySQL connection (the database is created by `flask --app app init-db`)
DB_HOST=localhost
DB_PORT=3306
DB_USER=simply_garlic_app
DB_PASSWORD=replace-me
DB_NAME=simply_garlic
